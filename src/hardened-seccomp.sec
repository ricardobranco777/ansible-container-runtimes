# The kernel reads the int arguments of socket from the low 32 bits, but seccomp compares 64.
# Mask the deny so socket(AF_NETLINK, x, 0x100000009) can't skip it, and keep it before the
# allows below: it overlaps socket 16 3 0x100000009 with them, and the order decides.
socket	ERRNO(EINVAL)	arg0&0xffffffff==AF_NETLINK && arg2&0xffffffff==NETLINK_AUDIT && !cap:AUDIT_WRITE
# Docker is more strict here
socket	ALLOW	arg0<3
socket	ALLOW	arg0==AF_ASH
socket	ALLOW	arg0==AF_ATMPVC
socket	ALLOW	arg0==AF_BLUETOOTH
socket	ALLOW	arg0==AF_BRIDGE
#socket	ALLOW	arg0==AF_CAN
socket	ALLOW	arg0==AF_IB
socket	ALLOW	arg0==AF_IEEE802154
socket	ALLOW	arg0==AF_INET6
socket	ALLOW	arg0==AF_IUCV
socket	ALLOW	arg0==AF_KCM
#socket	ALLOW	arg0==AF_KEY
socket	ALLOW	arg0==AF_LLC
socket	ALLOW	arg0==AF_MCTP
#socket	ALLOW	arg0==AF_MPLS
socket	ALLOW	arg0==AF_NETBEUI
socket	ALLOW	arg0==AF_NETLINK && arg2!=NETLINK_AUDIT && !cap:AUDIT_WRITE
socket	ALLOW	arg0==AF_NETLINK && cap:AUDIT_WRITE
#socket	ALLOW	arg0==AF_NFC
socket	ALLOW	arg0==AF_PACKET
#socket	ALLOW	arg0==AF_PHONET
#socket	ALLOW	arg0==AF_PPPOX
#socket	ALLOW	arg0==AF_QIPCRTR
#socket	ALLOW	arg0==AF_RDS
#socket	ALLOW	arg0==AF_RXRPC
socket	ALLOW	arg0==AF_SECURITY
socket	ALLOW	arg0==AF_SMC
socket	ALLOW	arg0==AF_SNA
#socket	ALLOW	arg0==AF_TIPC
#socket	ALLOW	arg0==AF_X25
socket	ALLOW	arg0==AF_XDP
socketcall	ALLOW
# The kernel blocks any family not AF_UNIX or AF_TIPC but after loading their modules.
socketpair	ALLOW	arg0==AF_LOCAL
#socketpair	ALLOW	arg0==AF_TIPC
