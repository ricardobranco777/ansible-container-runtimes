# Missing in Podman, allowed in Docker https://github.com/moby/profiles/commit/4d30d2d2b7dbbca6baaf00cf2e826c6caab0f88b
uretprobe	ALLOW
uselib	ERRNO(EPERM)
userfaultfd	ERRNO(EPERM)
# Obsolete ARM 26-bit mode
#usr26	ERRNO(ENOSYS)
# Obsolete ARM 26-bit mode
#usr32	ERRNO(ENOSYS)
ustat	ERRNO(EPERM)
utime	ALLOW
utimensat	ALLOW
utimensat_time64	ALLOW
utimes	ALLOW
vfork	ALLOW
vhangup	ALLOW	cap:SYS_TTY_CONFIG
vhangup	ERRNO(EPERM)	!cap:SYS_TTY_CONFIG
vm86	ERRNO(EPERM)
vm86old	ERRNO(EPERM)
# Dropped in https://github.com/containers/common/commit/7ced5daafa0e36102eb931050ba3ff99f42bdfac
vmsplice	ERRNO(EPERM)
# Unimplemented in Linux: always ENOSYS
#vserver	ERRNO(ENOSYS)
wait4	ALLOW
waitid	ALLOW
waitpid	ALLOW
write	ALLOW
writev	ALLOW
